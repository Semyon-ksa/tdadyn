# Данные генерируются целиком из config.yaml + seed, в репозиторий не попадают.
# В git хранится manifest.json, чтобы отслеживать, чем именно был собран набор.
# Исключения перечислены по шагам: git не возвращает файлы из исключённого каталога,
# поэтому каждый уровень пути приходится открывать отдельно.
data/*
!data/synthetic/
data/synthetic/*
!data/synthetic/manifest.json
# Отчётные числа Результата 6: производятся сборкой (--results), а не тестами,
# и должны переживать пересборку данных.
!data/synthetic/results/
data/synthetic/results/*
!data/synthetic/results/stability.json
# Отчётные числа Результата 2: производятся сборкой (tdadyn.zigzag.run --results).
# Исключения здесь пофайловые, поэтому каждый новый артефакт надо открывать отдельно —
# иначе он игнорируется молча, как это уже случилось с manifest.json.
!data/synthetic/results/zigzag_events.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/
.DS_Store
